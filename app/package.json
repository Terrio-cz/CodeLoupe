{
  "name": "codeloupe-desktop",
  "version": "0.4.0",
  "private": true,
  "description": "CodeLoupe desktop app: token usage and savings, branches, tasks, index health and gaps from the local daemon",
  "author": {
    "name": "Terrio",
    "email": "codeloupe@users.noreply.github.com"
  },
  "homepage": "https://github.com/Terrio-cz/CodeLoupe",
  "main": "out/main/index.js",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "stage": "node scripts/stage-resources.mjs",
    "dist": "electron-vite build && node scripts/stage-resources.mjs && electron-builder --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "global-agent": "4.1.3"
  }
}
