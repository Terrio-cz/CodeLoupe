* text=auto
gradlew text eol=lf
*.bat text eol=crlf
*.jar binary
# Golden outputs carry hashes of fixture text: keep the fixtures byte-identical on every OS.
src/test/resources/fixtures/** text eol=lf
# The plugin hook runs under bash on every OS: a CRLF checkout would break it.
plugin/hooks/*.sh text eol=lf
# SKILL.md frontmatter is matched with a LF-only pattern (app/test/pluginFiles.test.ts); CRLF broke it on Windows.
plugin/skills/**/*.md text eol=lf
